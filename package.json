{
  "name": "eslint-plugin-oxfmt",
  "type": "module",
  "version": "0.13.0",
  "packageManager": "pnpm@11.10.0",
  "description": "An ESLint plugin for formatting code with oxfmt.",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "oxc",
    "oxfmt",
    "oxlint",
    "prettier"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/eslint-plugin-oxfmt#readme",
  "repository": "ntnyq/eslint-plugin-oxfmt",
  "bugs": {
    "url": "https://github.com/ntnyq/eslint-plugin-oxfmt/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./rule-options": {
      "types": "./dts/rule-options.d.ts"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "dts",
    "workers"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "pnpm run update:rule-options && tsdown",
    "check:schema": "tsx scripts/checkSchemaParity.ts",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build",
    "release": "run-s release:check release:version",
    "release:check": "run-s check:schema format:check lint typecheck test build",
    "release:version": "bumpp",
    "test": "vitest",
    "typecheck": "tsgo --noEmit",
    "update:rule-options": "tsx scripts/updateRuleOptions.ts"
  },
  "peerDependencies": {
    "eslint": "^9.5.0 || ^10.0.0",
    "oxfmt": ">=0.58.0",
    "svelte": "*"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "dependencies": {
    "generate-differences": "^0.1.1",
    "ignore": "^7.0.5",
    "load-oxfmt-config": "^0.14.0",
    "picomatch": "^4.0.5",
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.1.0",
    "@typescript/native-preview": "^7.0.0-dev.20260706.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.6.0",
    "eslint-parser-plain": "^0.1.1",
    "eslint-plugin-oxfmt": "workspace:*",
    "eslint-typegen": "^2.3.1",
    "eslint-vitest-rule-tester": "^3.1.0",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.1.0",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.58.0",
    "show-invisibles": "^0.0.2",
    "svelte": "^5.56.4",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.22.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  }
}
