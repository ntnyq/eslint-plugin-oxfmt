{
  "name": "root",
  "type": "module",
  "version": "0.23.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "check:package": "pnpm --filter \"./packages/*\" pack --dry-run",
    "check:schema": "pnpm --filter eslint-plugin-oxfmt run check:schema",
    "check:versions": "tsx scripts/checkVersions.ts",
    "dev": "pnpm build && pnpm -r --parallel run dev",
    "format": "oxfmt --disable-nested-config",
    "format:check": "oxfmt --check --disable-nested-config",
    "lint": "eslint",
    "prepare": "husky",
    "release": "run-s release:check release:version",
    "release:check": "run-s check:versions build check:schema format:check lint typecheck test check:package",
    "release:version": "bumpp",
    "test": "pnpm -r run test",
    "typecheck": "tsgo --noEmit",
    "update:rule-options": "pnpm --filter eslint-plugin-oxfmt run update:rule-options"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^7.0.0-beta.19",
    "@types/node": "^26.5.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "tinyglobby": "^0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "nano-staged": {
    "*.{js,ts,mjs,tsx,md,vue,yml,yaml,toml,json}": "eslint --fix",
    "*": "oxfmt --disable-nested-config --no-error-on-unmatched-pattern"
  }
}
